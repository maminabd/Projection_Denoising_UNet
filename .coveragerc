# .coveragerc

[run]
source = libs
omit =
    libs/__init__.py
    libs/utils.py:get_device
    libs/utils.py:plot_history
    libs/utils.py:projs_comparison
    training.py
    predict.py
    tests/*
    */site-packages/*

[report]
show_missing = true
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
